#: .\templates\landing\home.html:928
msgid ""
"Apply to become a registered veterinary doctor and help farmers in your area."
msgstr ""
"Isa chikumbiro kuve dokotela wemhuka anyoreswa ubatsire varimi mundunhu yako."

#: .\templates\landing\home.html:929
#: .\templates\vets\track_application.html:753
msgid "Apply Now"
msgstr "Isa Chikumbiro Iye Zvino"

#: .\templates\landing\home.html:932
