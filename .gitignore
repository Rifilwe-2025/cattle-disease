# Environment
.env
.env.local

# --- Virtual environments -------------------------------------------------
# "venv/" alone does not match sibling names like venv_old_laptop_dead/,
# which would otherwise commit ~700MB of another machine's site-packages.
venv*/
.venv/

# --- Accidental nested copy of the whole project --------------------------
# Created when the project folder was transferred between laptops. It has
# its own .git, so git would otherwise add it as an embedded repo.
Early Disease Prediction For Cattle/

# --- Local database backups ----------------------------------------------
db.sqlite3.backup-*
*.sqlite3.bak

# --- Office lock files ----------------------------------------------------
~$*

# --- Database backups and data dumps -------------------------------------
# data-from-sqlite.json is a full dumpdata fixture: it contains every user's
# email and pbkdf2 password hash. This repo is public - keep it local. It is
# still needed on this machine to seed Neon/PostgreSQL.
backups/
